{
  "name": "lunar-testbench-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Tailwind pipeline for the lunar-testbench WebOS shell. Run alongside `dx serve`.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i input.css -o assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i input.css -o assets/tailwind.css --watch",
    "test:e2e": "bash ../../scripts/e2e-webos.sh",
    "test:responsive": "npx playwright test e2e/responsive.spec.ts",
    "test:visual": "npx playwright test e2e/visual.spec.ts",
    "test:visual:update": "npx playwright test e2e/visual.spec.ts --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tailwindcss": "^3.4.13"
  }
}
