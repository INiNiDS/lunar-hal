{
  "name": "lunar-testbench-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Tailwind pipeline for the lunar-testbench WebOS shell. Run alongside `dx serve`.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i input.css -o assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i input.css -o assets/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
