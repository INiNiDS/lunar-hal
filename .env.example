# lunar-hal secrets — committed template.
#
# 1. Copy this file to .env:
#       cp .env.example .env
# 2. Fill in your real values.
# 3. .env is in .gitignore and will never be committed.
#
# If you run deploy/orchestrate.sh or deploy/run-podman.sh from the repo root
# with .env present, it is sourced automatically.

# --- ESA Gaia Archive ---
# Sign up at https://gea.esac.esa.int → Login.
# Anonymous access is allowed but limited in result-set size; authed users can
# pull much larger async jobs.
# Optional secrets — values must stay outside Git
NASA_API_KEY=
GAIA_USERNAME=
GAIA_PASSWORD=

# --- MAST (STScI) ---
# Needed only for protected/EAP MAST products; the public TIC metadata spike
# used by the default pipeline is anonymous. MyST token expires after 10 days
# of inactivity (60 days since creation) — rotate via auth.mastToken.
MAST_API_TOKEN=

# --- Run parameters (consumed by orchestrate.sh / podman compose) ---
TOTAL_STARS=30000000
CHUNK_SIZE=3000000
JOBS=3

# --- Sink: "s3" for MinIO/RustFS, "local" for ./data/ ---
SINK_KIND=s3

# --- Object storage used by `lnaicli storage-*` (stage 4A extension) ---
# Any S3-compatible endpoint: local MinIO (install/data-minio.compose.yml),
# DigitalOcean Spaces, AWS S3, Cloudflare R2 — the client is SigV4 + path
# or virtual-host addressing.
#   S3_* names are canonical; SPACES_* below remain supported as legacy aliases.
# S3_ENDPOINT=http://127.0.0.1:9000      # scheme://host[:port], no trailing slash
# S3_BUCKET=lunar-hal-data
# S3_REGION=us-east-1                    # default us-east-1 when unset
# S3_ACCESS_KEY_ID=                      # REQUIRED for uploads; reads can stay anonymous
# S3_SECRET_ACCESS_KEY=                  # pair with S3_ACCESS_KEY_ID (never commit real values)
# S3_PATH_STYLE=true                     # true = MinIO-style http://host/bucket/key

# --- Local MinIO (matches install/podman-compose.yml defaults) ---
# Used by `podman-compose -f install/podman-compose.yml up`.
# run-podman.sh overrides SPACES_ENDPOINT to 127.0.0.1:9000 when in host network.
SPACES_KEY=minioadmin
SPACES_SECRET=minioadmin
SPACES_BUCKET=lunar-hal-data
SPACES_REGION=us-east-1
SPACES_ENDPOINT=minio:9000

# --- DigitalOcean Spaces (cloud.digitalocean.com → Spaces → API) ---
# Generate under https://cloud.digitalocean.com → Spaces → API → "Spaces Keys".
# Uncomment and fill in to switch the sink to DigitalOcean in production.
# SPACES_KEY=your_spaces_access_key
# SPACES_SECRET=your_spaces_secret_key
# SPACES_REGION=sfo3
# SPACES_ENDPOINT=
WORKDIR=/work

# --- Lunar frontend runtime (managed by lunar-start) ---
# LUNAR_START_HOST=127.0.0.1
# LUNAR_START_PORT=16181
# LUNAR_BACKEND_HOST=127.0.0.1
# LUNAR_BACKEND_PORT=25255
# LUNAR_TESTBENCH_HOST=127.0.0.1
# LUNAR_TESTBENCH_PORT=25256
# LUNAR_TESTBENCH_BACKEND_PORT=25256
# LUNAR_FRONTEND_PLATFORM=web       # web | desktop | android
# LUNAR_FRONTEND_PORT=8080          # web only
# LUNAR_BACKEND_URL=http://127.0.0.1:25255
# LUNAR_FRONTEND_STATE_DIR=/absolute/path/to/lunar/frontend-state
# Optional persistent Gallery directory. Defaults to the platform data directory
# plus `lunar/gallery` when unset.
# LUNAR_GALLERY_DIR=/absolute/path/to/lunar/gallery
# Android emulator default: http://10.0.2.2:25255
# Use an explicit reachable host URL for a physical Android device.


# Non-secret endpoints
NASA_EXOPLANET_TAP_URL=https://exoplanetarchive.ipac.caltech.edu/TAP
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP
JPL_HORIZONS_URL=https://ssd.jpl.nasa.gov/api/horizons.api
GAIA_TAP_URL=https://gea.esac.esa.int/tap-server/tap